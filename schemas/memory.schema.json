{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Sleep Lab memory (design v0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "memory_id",
    "scope",
    "kind",
    "claim",
    "status",
    "evidence",
    "observed_at",
    "valid_until",
    "supersedes",
    "tags",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "memory_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "task_family"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "task_family": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "kind": {
      "enum": [
        "preference",
        "procedure",
        "fact",
        "hypothesis"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "candidate",
        "verified",
        "rejected",
        "superseded",
        "stale"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "source_uri",
          "locator"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "source_uri": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "verifier",
        "result"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "verifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "enum": [
            "pending",
            "confirmed",
            "rejected"
          ]
        }
      }
    }
  }
}
