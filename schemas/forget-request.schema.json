{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Sleep Lab logical-forget request (Gate 3, agent-sleep-forget-request/1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "run_id",
    "scope",
    "expected_policy_revision",
    "targets"
  ],
  "properties": {
    "schema_version": {"const": "agent-sleep-forget-request/1"},
    "operation_id": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "run_id": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "task_family"],
      "properties": {
        "project": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "task_family": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
      }
    },
    "expected_policy_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_ids", "event_ids", "root_ids"],
      "properties": {
        "memory_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}},
        "event_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}},
        "root_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}
      }
    }
  }
}
