{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Sleep Lab source manifest (Gate 2B, agent-sleep-source-manifest/1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "entries"],
  "properties": {
    "schema_version": {"const": "agent-sleep-source-manifest/1"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "task_family"],
      "properties": {
        "project": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "task_family": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
      }
    },
    "entries": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memory_id", "memory_sha256", "evidence"],
        "properties": {
          "memory_id": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "memory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["event_id", "event_sha256", "source_sha256", "provenance_sha256"],
              "properties": {
                "event_id": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
                "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "provenance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
