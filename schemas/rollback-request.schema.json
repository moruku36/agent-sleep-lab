{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Sleep Lab rollback request (Gate 3, agent-sleep-rollback-request/1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "run_id",
    "scope",
    "expected_head_snapshot_sha256",
    "target_snapshot_sha256",
    "expected_policy_revision"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-sleep-rollback-request/1"
    },
    "operation_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "task_family"
      ],
      "properties": {
        "project": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "task_family": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "expected_head_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_policy_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  }
}
