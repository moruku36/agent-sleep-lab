{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Sleep Lab current control policy (Gate 2B, agent-sleep-control-policy/1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "authorizations", "accepted_purposes", "accepted_partitions", "exclusions", "set_by", "set_at"],
  "properties": {
    "schema_version": {"const": "agent-sleep-control-policy/1"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "authorizations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "revision"],
        "properties": {
          "ref": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "revision": {"type": "integer", "minimum": 0, "maximum": 2147483647}
        }
      }
    },
    "accepted_purposes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
    },
    "accepted_partitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"}
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_ids", "event_ids", "root_ids"],
      "properties": {
        "memory_ids": {"type": "array", "maxItems": 1024, "items": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}},
        "event_ids": {"type": "array", "maxItems": 1024, "items": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}},
        "root_ids": {"type": "array", "maxItems": 1024, "items": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}
      }
    },
    "set_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_id", "boundary_version"],
      "properties": {
        "boundary_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "boundary_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}
      }
    },
    "set_at": {"type": "string", "maxLength": 20, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
