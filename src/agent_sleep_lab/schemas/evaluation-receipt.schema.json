{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Sleep Lab evaluation receipt (Gate 2B, agent-sleep-evaluation-receipt/1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "snapshot_sha256", "operations_sha256", "source_manifest_sha256", "expected_parent_sha256", "scope", "protocol", "result", "completeness", "issued_at", "expires_at", "limits", "boundary"],
  "properties": {
    "schema_version": {"const": "agent-sleep-evaluation-receipt/1"},
    "receipt_id": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operations_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_parent_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "task_family"],
      "properties": {
        "project": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "task_family": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "config_sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "result": {"enum": ["passed", "failed", "incomplete"]},
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned", "completed"],
      "properties": {
        "planned": {"type": "integer", "minimum": 1, "maximum": 100000},
        "completed": {"type": "integer", "minimum": 0, "maximum": 100000}
      }
    },
    "issued_at": {"type": "string", "maxLength": 20, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expires_at": {"type": ["string", "null"], "maxLength": 20, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic_only"],
      "properties": {"synthetic_only": {"const": true}}
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_id", "boundary_version"],
      "properties": {
        "boundary_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "boundary_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}
      }
    }
  }
}
