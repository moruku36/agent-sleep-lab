{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Sleep Lab adoption request (Gate 2B, agent-sleep-adoption-request/2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "run_id",
    "scope",
    "expected_parent_snapshot_sha256",
    "expected_policy_revision",
    "operations_sha256",
    "source_manifest_sha256",
    "candidate_snapshot_sha256",
    "evaluation_receipt"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-sleep-adoption-request/2"
    },
    "operation_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "task_family"
      ],
      "properties": {
        "project": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "task_family": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "expected_parent_snapshot_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_policy_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "operations_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_snapshot_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluation_receipt": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_sha256"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "run_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
